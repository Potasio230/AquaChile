# API FastAPI incluida en este repositorio.
VITE_API_URL=http://127.0.0.1:8000/api

# MongoDB Atlas. Copiar este archivo como .env y reemplazar los valores localmente.
# Nunca subir la cadena real de conexión a GitHub.
AQUACHILE_DB_MODE=mongodb
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=aquachile

# Dominios autorizados para usar la API, separados por coma.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Para trabajar sin Internet se puede usar temporalmente:
# AQUACHILE_DB_MODE=sqlite
