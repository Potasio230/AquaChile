# ─────────────────────────────────────────────────────────────
# Plantilla de configuración local
# Copia este archivo como .env y ajusta los valores:
#   Windows:     Copy-Item .env.example .env
#   Linux/macOS: cp .env.example .env
# ─────────────────────────────────────────────────────────────

# URL pública de la API. En desarrollo el frontend llama a /api y Vite
# lo redirige al backend; esta variable se usa en el build de producción.
VITE_API_URL=http://127.0.0.1:8001/api

# Destino del proxy de Vite en desarrollo (opcional; por defecto 8001).
# VITE_API_PROXY_TARGET=http://127.0.0.1:8001

# Persistencia: "sqlite" (local, sin Internet) o "mongodb" (Atlas).
AQUACHILE_DB_MODE=sqlite

# Ruta alternativa para la base SQLite (opcional).
# AQUACHILE_SQLITE_PATH=backend/data/aquachile.db

# MongoDB Atlas (solo si AQUACHILE_DB_MODE=mongodb).
# MONGODB_URI=mongodb+srv://usuario:clave@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DATABASE=aquachile

# Gmail SMTP. Usa una contraseña de aplicación, no la de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASSWORD=tu-contraseña-de-aplicación
SMTP_FROM=tu-cuenta@gmail.com
SMTP_TIMEOUT_SECONDS=10

# URLs usadas en los correos de notificación.
PUBLIC_APP_URL=http://localhost:5173
INTERNAL_APP_URL=http://localhost:5173

# Orígenes permitidos por CORS (separados por coma).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
